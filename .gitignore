# Dart/Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.g.dart

# Android secrets (generated in CI from GitHub Secrets)
android/key.properties
android/app/*.jks
android/app/*.jks.b64
*.keystore

# Firebase config (contains project identifiers — add via CI secrets if needed)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Environment / secrets
.env
*.env

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Generated localizations — produced by `flutter gen-l10n` from lib/l10n/*.arb
# on every pub get and build. The .arb source files are tracked; these are not.
lib/l10n/app_localizations*.dart
