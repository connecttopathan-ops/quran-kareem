<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_mosque"
            android:layout_marginEnd="6dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prayer Times"
                android:textColor="#F5ECD7"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#9A8060"
                android:textSize="9sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/next_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next"
                android:textColor="#9A8060"
                android:textSize="8sp"/>
            <TextView
                android:id="@+id/next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#C9A84C"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A1E08"
        android:layout_marginBottom="6dp"/>

    <!-- Prayer rows -->
    <LinearLayout android:id="@+id/row_fajr"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="6dp"
        android:paddingEnd="6dp" android:layout_marginBottom="2dp">
        <TextView android:id="@+id/lbl_fajr"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Fajr"
            android:textColor="#9A8060" android:textSize="12sp"/>
        <TextView android:id="@+id/time_fajr"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--:--" android:textColor="#F5ECD7"
            android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_dhuhr"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="6dp"
        android:paddingEnd="6dp" android:layout_marginBottom="2dp">
        <TextView android:id="@+id/lbl_dhuhr"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Dhuhr"
            android:textColor="#9A8060" android:textSize="12sp"/>
        <TextView android:id="@+id/time_dhuhr"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--:--" android:textColor="#F5ECD7"
            android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_asr"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="6dp"
        android:paddingEnd="6dp" android:layout_marginBottom="2dp">
        <TextView android:id="@+id/lbl_asr"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Asr"
            android:textColor="#9A8060" android:textSize="12sp"/>
        <TextView android:id="@+id/time_asr"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--:--" android:textColor="#F5ECD7"
            android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_maghrib"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="6dp"
        android:paddingEnd="6dp" android:layout_marginBottom="2dp">
        <TextView android:id="@+id/lbl_maghrib"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Maghrib"
            android:textColor="#9A8060" android:textSize="12sp"/>
        <TextView android:id="@+id/time_maghrib"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--:--" android:textColor="#F5ECD7"
            android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/row_isha"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <TextView android:id="@+id/lbl_isha"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Isha"
            android:textColor="#9A8060" android:textSize="12sp"/>
        <TextView android:id="@+id/time_isha"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--:--" android:textColor="#F5ECD7"
            android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
