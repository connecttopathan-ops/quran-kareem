  },
  "hasanatRowTotalGiven": "Total given",
  "@hasanatRowTotalGiven": {
    "description": "Label of the last row in the 'Your Giving Plan' summary card on the recurring tab, whose value on the right is the monthly sum multiplied by the number of months — the whole amount the user would give over the chosen period."
  },
  "hasanatYourGivingPlan": "YOUR GIVING PLAN",
  "@hasanatYourGivingPlan": {
    "description": "Small all-capitals heading at the top of the card that summarises the recurring donation the user has configured (monthly sum, duration, total). Supplied already in capitals; use capital letters if that is natural for your language."
  },
  "hasanatMinimumPerSource": "Minimum (per {source})",
  "@hasanatMinimumPerSource": {
    "description": "Label of a small highlighted row showing the lowest number of rewards the chosen donation may earn, with the scripture that states that multiplier given in brackets. {source} is a scripture citation such as 'Quran 6:160' supplied by the app: it is a scholarly reference, so leave its numerals and its chapter:verse format exactly as they arrive. Translate only the word 'Minimum' and the word 'per', which here means 'according to'.",
    "placeholders": {
      "source": {
        "type": "String",
        "example": "Quran 6:160"
      }
    }
  },
  "hasanatUpToPerSource": "Up to (per {source})",
  "@hasanatUpToPerSource": {
    "description": "Label of a small highlighted row showing the highest number of rewards the chosen donation may earn, with the scripture that states that multiplier given in brackets. {source} is a scripture citation such as 'Quran 2:261' supplied by the app: it is a scholarly reference, so leave its numerals and its chapter:verse format exactly as they arrive. 'Up to' means 'as much as'; 'per' here means 'according to'.",
    "placeholders": {
      "source": {
        "type": "String",
        "example": "Quran 2:261"
      }
    }
  },
  "hasanatUnit": "hasanat",
  "@hasanatUnit": {
    "description": "Unit written in small grey text immediately after the calculated reward figure, e.g. '7,000 hasanat'. 'Hasanat' is the Arabic plural for good deeds or rewards recorded for a believer: transliterate it conventionally rather than translating its meaning. It always follows a number greater than one, so use a plural form if your language has one. Lower case, very little room."
  },
  "hasanatNiyyahTitle": "Renew your niyyah",
  "@hasanatNiyyahTitle": {
    "description": "Heading of the small reminder banner at the top of both tabs of the rewards calculator, next to a heart icon, urging the user to refresh their inner intention before giving. 'Niyyah' is the Arabic term for the sincere intention behind a religious act: transliterate it conventionally rather than translating it. One short line."
  },
  "hasanatNiyyahBody": "All deeds are by intention. Only Allah knows what He accepts.",
  "@hasanatNiyyahBody": {
    "description": "Two short sentences in the reminder banner under 'Renew your niyyah', paraphrasing a well-known hadith that the worth of an act depends on the intention behind it, and cautioning that acceptance rests with God alone. 'Allah' is the Arabic name of God: transliterate it conventionally rather than translating it."
  },
  "hasanatSelectCurrency": "Select Currency",
  "@hasanatSelectCurrency": {
    "description": "Heading at the top of the sheet that slides up from the bottom of the rewards calculator listing currency codes (USD, GBP, EUR and so on) for the user to pick from."
  },
  "hasanatPromiseHeadingQuran": "Allah's Promise",
  "@hasanatPromiseHeadingQuran": {
    "description": "Small all-capitals caption at the top of a quotation card when the quotation comes from the Quran, marking the words as God's own pledge of reward. Shown in capitals with wide letter spacing, so keep it short. 'Allah' is the Arabic name of God: transliterate it conventionally rather than translating it."
  },
  "hasanatPromiseHeadingHadeeth": "Prophet ﷺ said",
  "@hasanatPromiseHeadingHadeeth": {
    "description": "Small all-capitals caption at the top of a quotation card when the quotation is a hadith, that is, a reported saying of the Prophet Muhammad. Shown in capitals with wide letter spacing, so keep it short. 'ﷺ' is the Arabic honorific glyph for 'peace be upon him': keep it exactly as it is, in the same position relative to the word for 'Prophet'."
  },
  "hasanatBadgeQuran": "QURAN",
  "@hasanatBadgeQuran": {
    "description": "Text on a tiny gold pill badge in the top right corner of a quotation card, marking that quotation as coming from the Quran. Supplied already in capitals; only about six characters fit."
  },
  "hasanatBadgeHadeeth": "HADEETH",
  "@hasanatBadgeHadeeth": {
    "description": "Text on a tiny gold pill badge in the top right corner of a quotation card, marking that quotation as a hadith — a recorded saying of the Prophet Muhammad. Transliterate the term conventionally rather than translating it. Supplied already in capitals; only about eight characters fit."
  },
  "hasanatSourceAttribution": "— {source}",
  "@hasanatSourceAttribution": {
    "description": "Citation line under a Quran or hadith quotation, naming where the quotation is from, e.g. '— Sahih al-Bukhari 450'. {source} is a scholarly reference supplied by the app and is never translated here: leave its numerals, punctuation and reference format untouched. The leading em dash (—) is the attribution mark; keep it, or replace it with the mark your language uses for a quotation's source.",
    "placeholders": {
      "source": {
        "type": "String",
        "example": "Surah Al-Baqarah 2:261"
      }
    }
  },
  "hasanatConditionsTitle": "Conditions for Reward",
  "@hasanatConditionsTitle": {
    "description": "Heading of the card listing what must be true for a charitable act to earn the promised reward (sincere intention, lawfully earned wealth, and so on). Shown in small bold capitals-ish letters with wide spacing next to a tick icon; keep it to about three words."
  },
  "hasanatDisclaimer": "The figures above are read directly from the cited verses — they are Allah's promise, not our calculation. Only Allah knows true acceptance.",
  "@hasanatDisclaimer": {
    "description": "Small grey note at the very bottom of both tabs of the rewards calculator, next to an information icon. It makes clear that the multipliers shown come from the quoted scripture rather than from the app, and that whether a deed is accepted is known only to God. 'Allah' is the Arabic name of God: transliterate it conventionally rather than translating it. Keep the em dash (—) or replace it with the equivalent separator in your language."
  },
  "qiblaTitle": "Qibla Direction",
  "@qiblaTitle": {
    "description": "Title in the top bar of the compass screen that points towards Mecca. 'Qibla' is the direction Muslims face in prayer: transliterate it conventionally rather than translating its meaning. One centred line at 16px."
  },
  "qiblaHoldPhoneFlat": "Hold phone flat for accurate reading",
  "@qiblaHoldPhoneFlat": {
    "description": "Warning on an orange strip across the top of the compass screen, shown while the phone is tilted more than thirty degrees from horizontal, which makes the compass unreliable. One line of small text."
  },
  "qiblaBearingDegrees": "{degrees}° to Qibla",
  "@qiblaBearingDegrees": {
    "description": "The compass bearing of Mecca from where the user is standing, shown prominently under the compass dial, e.g. '58.3° to Qibla'. {degrees} arrives already formatted to one decimal place. The degree sign (°) belongs with the number; keep it next to {degrees}. 'Qibla' is the direction Muslims face in prayer: transliterate rather than translate.",
    "placeholders": {
      "degrees": {
        "type": "String",
        "example": "58.3"
      }
    }
  },
  "qiblaDistanceFromMecca": "{distance} km from Mecca",
  "@qiblaDistanceFromMecca": {
    "description": "How far the user is from Mecca in a straight line, shown under the compass bearing, e.g. '4,312 km from Mecca'. {distance} is a whole number of kilometres, already grouped for the user's locale. 'km' is the international abbreviation for kilometres — keep it unless your language genuinely writes it differently. 'Mecca' is the city in Saudi Arabia; use the name customary in your language.",
    "placeholders": {
      "distance": {
        "type": "String",
        "example": "4,312"
      }
    }
  },
  "qiblaFacingQibla": "Facing Qibla",
  "@qiblaFacingQibla": {
    "description": "Confirmation shown in a green pill under the compass once the phone is pointing within two degrees of Mecca, meaning the user is now correctly oriented for prayer. 'Qibla' is the direction Muslims face in prayer: transliterate rather than translate. Two short words."
  },
  "qiblaFaceArrowDirection": "Face the direction of the arrow",
  "@qiblaFaceArrowDirection": {
    "description": "Instruction shown in a pill under the compass while the phone is not yet pointing at Mecca, telling the user to turn until they are facing the way the compass needle points. 'Face' is a verb here, meaning 'turn to look towards'. One line of small text."
  },
  "qiblaRecalibrate": "Recalibrate",
  "@qiblaRecalibrate": {
    "description": "Label on a small flat button under the compass that reopens the instructions for waving the phone about to re-calibrate its magnetic sensor. One short word."
  },
  "qiblaLocationFooter": "{city} ({lat}°N, {lon}°E)",
  "@qiblaLocationFooter": {
    "description": "Tiny grey footer at the bottom of the compass screen stating the place the bearing was computed for, e.g. 'London (51.5074°N, -0.1278°E)'. {city} is a place name supplied by the device and is not translated. {lat} and {lon} arrive already formatted to four decimal places. 'N' and 'E' abbreviate north and east — use your language's one-letter abbreviations if it has them, and keep each next to its own number. The values may be negative, in which case they denote south and west; this is accepted as-is.",
    "placeholders": {
      "city": {
        "type": "String",
        "example": "London"
      },
      "lat": {
        "type": "String",
        "example": "51.5074"
      },
      "lon": {
        "type": "String",
        "example": "-0.1278"
      }
    }
  },
  "qiblaCalibrationInstruction": "Move your phone in a\nfigure-8 motion to\ncalibrate the compass",
  "@qiblaCalibrationInstruction": {
    "description": "Instruction on the dark overlay that covers the compass screen for three seconds, telling the user to wave the phone through the air along a path shaped like the numeral 8 so its magnetic sensor re-calibrates. The three \\n characters are deliberate line breaks for the centred layout — keep roughly three short lines and put the breaks where your wording divides naturally. 'figure-8' describes the shape of the movement, not a quantity."
  },
  "qiblaTapToDismiss": "Tap to dismiss",
  "@qiblaTapToDismiss": {
    "description": "Faint hint at the bottom of the compass calibration overlay, telling the user they can touch anywhere on the screen to close it rather than waiting. Two or three short words."
  },
  "qiblaLocationRequired": "Location required for Qibla direction",
  "@qiblaLocationRequired": {
    "description": "Message filling the compass screen when the app does not know where the user is and therefore cannot work out which way Mecca lies. 'Qibla' is the direction Muslims face in prayer: transliterate rather than translate. Centred over two short lines."
  },
  "qiblaDetectLocation": "Detect Location",
  "@qiblaDetectLocation": {
    "description": "Label on the main gold button shown when the compass screen has no location, which asks the device to find the user's position. Keep it short enough to fit one line on a button."
  },
  "qiblaAccuracyHigh": "Accuracy: High",
  "@qiblaAccuracyHigh": {
    "description": "Status shown beside a green tick in the top right of the compass screen when the magnetic readings are steady and the bearing can be trusted. Very small text (11px) on one line; 'Accuracy' labels the reading and 'High' is its level."
