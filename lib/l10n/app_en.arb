    "description": "Tiny gold badge at the top of each entry on the reading screen, citing which hadith is shown, e.g. 'Hadith 4:112'. {number} is the collection's own reference, usually section:item — it is a citation and its digits, colon and order must be left exactly as supplied. 'Hadith' is a recorded saying of the Prophet: keep the conventional transliteration rather than translating it. Very small (9px), all in capitals in English — about 14 characters fit.",
    "placeholders": {
      "number": {
        "type": "String",
        "example": "4:112"
      }
    }
  },
  "booksSectionBookNumber": "Book {number}",
  "@booksSectionBookNumber": {
    "description": "Name given to one numbered section of a hadith collection in the chapter list of a book, used when the downloaded content supplies no title of its own, e.g. 'Book 4'. Here 'Book' means a numbered section within the collection, not the whole volume.",
    "placeholders": {
      "number": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "booksSectionChapterNumber": "Chapter {number}",
  "@booksSectionChapterNumber": {
    "description": "Name given to one chapter of a non-hadith book, such as a Seerah biography, in the book's chapter list, used when the content supplies no title of its own, e.g. 'Chapter 7'.",
    "placeholders": {
      "number": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "booksBookCount": "{count, plural, =1{{count} book} other{{count} books}}",
  "@booksBookCount": {
    "description": "Second line under a hadith collection's title at the top of its chapter list, saying how many numbered sections it contains, e.g. '97 books'. Here 'book' means one numbered section within the collection, not a whole volume. Shown in a 10px font; add whichever plural categories your language needs.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "97"
      }
    }
  },
  "booksChapterCount": "{count, plural, =1{{count} chapter} other{{count} chapters}}",
  "@booksChapterCount": {
    "description": "Second line under a non-hadith book's title at the top of its chapter list, saying how many chapters it contains, e.g. '24 chapters'. Shown in a 10px font; add whichever plural categories your language needs.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "24"
      }
    }
  },
  "booksHadithCount": "{count, plural, =1{{count} hadith} other{{count} hadiths}}",
  "@booksHadithCount": {
    "description": "Small caption under a section's title in a hadith collection's chapter list, saying how many hadiths that section holds, e.g. '112 hadiths'. 'Hadith' is a recorded saying of the Prophet: keep the conventional transliteration rather than translating it, and use your language's own plural of that transliterated word. Add whichever plural categories your language needs.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "112"
      }
    }
  },
  "booksPassageCount": "{count, plural, =1{{count} passage} other{{count} passages}}",
  "@booksPassageCount": {
    "description": "Small caption under a chapter's title in a non-hadith book's chapter list, saying how many passages of prose that chapter holds, e.g. '12 passages'. Add whichever plural categories your language needs.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "booksChapterFallbackTitle": "Chapter",
  "@booksChapterFallbackTitle": {
    "description": "Stand-in title for a row in the search results of a book's chapter list when that chapter carries no readable name. A bare noun with no number after it. One short word."
  },
  "permSheetTitle": "Setup Notifications",
  "@permSheetTitle": {
    "description": "Heading at the top of the bottom sheet that appears on launch asking the user to grant notification-related permissions. 'Setup' is a verb phrase meaning 'get your notifications ready'. Keep it to two or three words — it sits on one line next to a bell icon."
  },
  "permSheetSubtitle": "Never miss a prayer time",
  "@permSheetSubtitle": {
    "description": "One-line promise under the heading of the notification permissions sheet, explaining why the permissions are worth granting. Keep it short; it sits on one line under the heading."
  },
  "permAllowNotifications": "Allow Notifications",
  "@permAllowNotifications": {
    "description": "Used twice on the notification permissions sheet, so it must read well in both places: as the title of the first permission row, and as the label of the wide button at the bottom that triggers the system notification-permission dialog. An imperative phrase asking the user to permit notifications."
  },
  "permNotificationsDescription": "Required to receive prayer time alerts",
  "@permNotificationsDescription": {
    "description": "Small explanatory line under the 'Allow Notifications' row title on the notification permissions sheet, saying what the permission is needed for. Two lines of small text at most."
  },
  "permPreciseTimingTitle": "Precise Timing",
  "@permPreciseTimingTitle": {
    "description": "Title of the permission row on the notification permissions sheet for the Android 'Alarms & reminders' permission, which lets alerts fire at an exact minute. Shown only on Android 12 and newer when the permission has not been granted. Keep it short — one line next to an alarm icon."
  },
  "permPreciseTimingDescription": "Ensures notifications arrive exactly at prayer time, not minutes late",
  "@permPreciseTimingDescription": {
    "description": "Small explanatory line under the 'Precise Timing' row title on the notification permissions sheet, saying why exact-alarm permission matters."
  },
  "permBatteryTitle": "Always Run in Background",
  "@permBatteryTitle": {
    "description": "Title of the permission row on the notification permissions sheet for exempting the app from Android battery optimisation, so the system does not stop it from delivering alerts. Keep it short — one line next to a battery icon."
  },
  "permBatteryDescription": "Prevents your phone from blocking prayer alerts when the screen is off",
  "@permBatteryDescription": {
    "description": "Small explanatory line under the 'Always Run in Background' row title on the notification permissions sheet, saying why the battery exemption matters."
  },
  "permAllowButton": "Allow",
  "@permAllowButton": {
    "description": "Label on the small outlined button at the right edge of each permission row on the notification permissions sheet; tapping it starts granting that one permission. Very narrow — one short word."
  },
  "permAllSetContinue": "All Set — Continue",
  "@permAllSetContinue": {
    "description": "Label the wide button at the bottom of the notification permissions sheet switches to once notifications have been granted; tapping it closes the sheet. 'All Set' means everything needed is done. Keep the em dash (—) or replace it with the equivalent separator used in your language."
  },
  "permBatteryTipSamsung": "Samsung extra step: Settings → Battery → Never sleeping apps → tap + and add {appName}",
  "@permBatteryTipSamsung": {
    "description": "Extra instruction shown in a small bordered note inside the 'Always Run in Background' row on the notification permissions sheet, displayed only on Samsung phones. The words after 'Samsung extra step:' are the literal names of menu items in Samsung's own Android settings, which the phone shows in the user's language: if you know Samsung's official wording for these menus in your locale, use exactly that; otherwise leave the English menu names untranslated, because a guessed translation leaves the user unable to find the menu. Translate only the surrounding words ('extra step', 'tap', 'and add'). Keep the → arrows as separators. {appName} is this app's name and is never translated.",
    "placeholders": {
      "appName": {
        "type": "String",
        "example": "Get Quran"
      }
    }
  },
  "permBatteryTipXiaomi": "Xiaomi extra step: Settings → Apps → Manage apps → {appName} → AutoStart → turn On",
