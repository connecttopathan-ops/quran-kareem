  "hasanatCurrencyAmount": "{symbol}{amount}",
  "@hasanatCurrencyAmount": {
    "description": "A sum of money in the summary card of the recurring tab, e.g. '$1,500'. {symbol} is the currency sign the user picked and {amount} is the already-formatted number — leave both untouched, but move the symbol after the amount, or add a space, if that is how your language writes money.",
