  "tafsirTitle": "Tafsir",
  "@tafsirTitle": {
    "description": "Heading of the panel that shows the scholarly explanation of a single verse. 'Tafsir' is the established Arabic term for Qur'anic exegesis and is normally kept untranslated."
  },
  "tafsirOpenVerse": "Open tafsir for verse {verse}",
  "@tafsirOpenVerse": {
