  "hifzSearchEmptyHint": "Try a different name or number",
  "@hifzSearchEmptyHint": {
    "description": "Advice shown under the 'No surahs found' headline on the Hifz (memorisation) screen when the user's search text matches no chapter of the Quran. It names the two things the search box matches on: the chapter's transliterated Arabic name and its number from 1 to 114."
  },
  "hifzGetStartedTitle": "Begin Your Hifz Journey",
  "@hifzGetStartedTitle": {
    "description": "Headline of the welcoming block shown low on the Hifz screen while the user has not yet memorised a single verse. 'Hifz' is the memorisation of the Quran by heart: transliterate it conventionally rather than translating its meaning."
  },
  "hifzGetStartedBody": "Tap any surah below to start memorizing.\nMark each ayah with ★ as you learn it.",
  "@hifzGetStartedBody": {
    "description": "Two-sentence explanation under the 'Begin Your Hifz Journey' headline on the Hifz screen, telling the first-time user to open a chapter from the list below and then mark each verse with the star button once learnt. Keep the line break (\\n) between the two sentences and keep the ★ character, which stands for the star button in the player. 'Surah' is a chapter of the Quran and 'ayah' a verse: transliterate both conventionally rather than translating them."
  },
  "hifzGetStartedQuote": "\"And We have certainly made the Quran easy to remember\" — 54:17",
  "@hifzGetStartedQuote": {
    "description": "Encouraging Quran quotation in a small gold pill at the bottom of the welcome block on the Hifz screen, shown before the user has memorised anything. '54:17' is the conventional citation of chapter 54, verse 17 — keep the numerals and the colon exactly as they are. Use your language's established wording of this verse if there is one, keep it inside quotation marks, and keep the em dash before the citation (or your language's equivalent separator)."
  },
  "hifzSortBy": "Sort by:",
  "@hifzSortBy": {
    "description": "Small label at the left of a row of three buttons on the Hifz screen that change the order of the chapter list below. The buttons follow it on the same line, so keep it short and keep the trailing colon if your language uses one."
  },
  "hifzSortSurah": "Surah",
  "@hifzSortSurah": {
    "description": "First of three small pill buttons that reorder the chapter list on the Hifz screen; this one restores the Quran's own order, chapter 1 to 114. 'Surah' is the Arabic word for a chapter of the Quran and is normally kept as-is. The pill fits about 10 characters."
  },
  "hifzSortProgress": "Progress",
  "@hifzSortProgress": {
    "description": "Second of three small pill buttons that reorder the chapter list on the Hifz screen; this one puts the chapters the user has memorised most of at the top. The pill fits about 10 characters."
  },
  "hifzSortShortest": "Shortest",
  "@hifzSortShortest": {
    "description": "Third of three small pill buttons that reorder the chapter list on the Hifz screen; this one puts the chapters with the fewest verses first, as those are easiest to memorise. The pill fits about 10 characters."
  },
  "hifzTileVerseProgress": "{count} / {total, plural, =1{{total} verse} other{{total} verses}}",
  "@hifzTileVerseProgress": {
    "description": "Caption under the small progress bar on each chapter row of the Hifz screen, giving how many of that chapter's verses the user has memorised, e.g. '3 / 7 verses'. Very small text in a tight row. The plural applies to the chapter's total number of verses.",
