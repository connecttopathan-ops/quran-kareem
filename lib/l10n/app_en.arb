  },
  "hasanatSectionDuration": "Duration",
  "@hasanatSectionDuration": {
    "description": "Used twice on the recurring tab of the rewards calculator: as the tiny all-caps heading above the slider that sets how long the monthly giving continues, and as the label of the matching row in the summary card (where it is shown in normal case). The app uppercases it for the heading, so supply it in normal case. One short word."
  },
  "hasanatSectionTypeOfDeed": "Type of Deed",
  "@hasanatSectionTypeOfDeed": {
    "description": "Tiny all-caps heading above a row of chips where the user picks what kind of charitable act they are giving (ordinary charity, an endowment, feeding the poor, and so on). 'Deed' here means a good act, not a legal document. The app uppercases it."
  },
  "hasanatDurationMonths": "{count, plural, =1{{count} month} other{{count} months}}",
  "@hasanatDurationMonths": {
    "description": "A giving period shorter than a year on the recurring tab of the rewards calculator. Shown large under the duration slider, as the left end label of that slider (always '1 month' there), and in the summary card. Plural because many languages inflect the noun.",
