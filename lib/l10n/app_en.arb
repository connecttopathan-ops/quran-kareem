{
  "@@locale": "en",

  "appTitle": "Get Quran",
  "@appTitle": {
    "description": "The app's name. Left untranslated in most locales — it is a brand name, not a phrase."
  },

  "about": "About",
  "@about": {
    "description": "Section heading above the app name and version in settings."
  },

  "version": "Version {number}",
  "@version": {
    "description": "App version shown in the About section.",
    "placeholders": {
      "number": {
        "type": "String",
        "example": "1.1.0"
      }
    }
  },

  "appLanguage": "App Language",
  "@appLanguage": {
    "description": "Settings row that chooses the language of the interface itself — buttons, labels, menus. Distinct from translationLanguage, which chooses the Quran translation."
  },

  "appLanguageSubtitle": "Language of buttons and menus",
  "@appLanguageSubtitle": {
    "description": "Explains appLanguage, so it is not confused with the Quran translation setting."
  },

  "translationLanguage": "Translation Language",
  "@translationLanguage": {
    "description": "Settings row that chooses which Quran translation is displayed. Distinct from appLanguage."
  },

  "translationLanguageSubtitle": "Language of the Quran translation",
  "@translationLanguageSubtitle": {
    "description": "Explains translationLanguage, so it is not confused with the interface language."
  },

  "matchDeviceLanguage": "Match device language",
  "@matchDeviceLanguage": {
    "description": "Option in the app language picker that follows the phone's own language setting instead of a fixed choice."
  },

  "save": "Save",
  "@save": {
    "description": "Button that commits a change."
  },

  "cancel": "Cancel",
  "@cancel": {
    "description": "Button that dismisses a dialog without saving."
  },

  "done": "Done",
  "@done": {
    "description": "Button that closes a screen once the user has finished with it."
  },

  "continueLabel": "Continue",
  "@continueLabel": {
    "description": "Button that moves to the next step. Named continueLabel because `continue` is a reserved word in Dart."
  },

  "maybeLater": "Maybe later",
  "@maybeLater": {
    "description": "Dismisses a permission prompt without granting it. Should read as a genuine option, not a refusal — the user can always come back via Settings."
  },

  "openAppSettings": "Open app settings",
  "@openAppSettings": {
    "description": "Link that opens the operating system's settings page for this app, so a previously denied permission can be granted."
  },

  "surahVerseCount": "{count, plural, =1{{count} verse} other{{count} verses}}",
  "@surahVerseCount": {
    "description": "Number of verses in a surah, shown under its name in lists. Plural because many languages inflect the noun.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "286"
      }
    }
  },

  "surahSubtitle": "Surah {number} · {verses}",
  "@surahSubtitle": {
    "description": "Subtitle under a surah name, e.g. 'Surah 2 · 286 verses'. Built from a whole sentence rather than concatenated fragments so word order can change per language.",
    "placeholders": {
      "number": {
        "type": "int",
        "example": "2"
      },
      "verses": {
        "type": "String",
        "example": "286 verses"
      }
    }
  },

  "nextPrayerIn": "Next: {prayer} in {countdown}",
  "@nextPrayerIn": {
    "description": "Live countdown on the home screen, e.g. 'Next: Maghrib in 2h 15m'. Translators: place {prayer} and {countdown} wherever the language needs them — both are rendered in an accent colour, which follows them. Keep it short; it sits on one line in a compact row.",
    "placeholders": {
      "prayer": {
        "type": "String",
        "example": "Maghrib"
      },
      "countdown": {
        "type": "String",
        "example": "2h 15m 30s"
      }
    }
  },

  "sunriseIn": "Sunrise in {countdown}",
  "@sunriseIn": {
    "description": "Countdown to sunrise, shown between Fajr and sunrise. {countdown} is rendered in an accent colour.",
    "placeholders": {
      "countdown": {
        "type": "String",
        "example": "42m 10s"
      }
    }
  },

  "sunriseWasAt": "Sunrise was at {time}",
  "@sunriseWasAt": {
    "description": "Shown for an hour after sunrise has passed. {time} is a clock time rendered in an accent colour.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "6:42 AM"
      }
    }
  },

  "surahNumber": "Surah {number}",
  "@surahNumber": {
    "description": "A surah's position in the Quran, shown on compact cards where there is no room for the verse count.",
    "placeholders": {
      "number": {
        "type": "int",
        "example": "2"
      }
    }
  },

  "ayahReference": "Surah {surahName} · {surahNumber}:{ayahNumber}",
  "@ayahReference": {
    "description": "Cites a specific verse, e.g. 'Surah Al-Baqarah · 2:3'. The chapter:verse part is a conventional citation format — keep the colon and the numeral order as they are, even where the surrounding words move.",
    "placeholders": {
      "surahName": {
        "type": "String",
        "example": "Al-Baqarah"
      },
      "surahNumber": {
        "type": "int",
        "example": "2"
      },
      "ayahNumber": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "settingsTitle": "Settings",
  "@settingsTitle": { "description": "Title bar of the settings screen." },

  "sectionAppearance": "Appearance",
  "@sectionAppearance": { "description": "Settings section grouping theme and display options." },

  "sectionLanguage": "Language",
  "@sectionLanguage": { "description": "Settings section grouping the app language and Quran translation language controls." },

  "sectionReading": "Reading",
  "@sectionReading": { "description": "Settings section grouping font sizes and reading display options." },

  "sectionIslamicBooks": "Islamic Books",
  "@sectionIslamicBooks": { "description": "Settings section for the hadith and Islamic book collections." },

  "sectionQuranAudio": "Quran Audio",
  "@sectionQuranAudio": { "description": "Settings section for recitation audio options." },

  "sectionNotifications": "Notifications",
  "@sectionNotifications": { "description": "Settings section for prayer alerts and daily reminders." },

  "darkMode": "Dark Mode",
  "@darkMode": { "description": "Toggle between the light and dark colour theme." },

  "darkModeSubtitle": "Switch between light and dark theme",
  "@darkModeSubtitle": { "description": "Explains the Dark Mode toggle." },

  "arabicFontSize": "Arabic Font Size",
  "@arabicFontSize": { "description": "Slider controlling how large the Arabic Quran text is rendered." },

  "showTransliteration": "Show Transliteration",
  "@showTransliteration": { "description": "Toggle for the Roman-letter phonetic rendering of the Arabic." },

  "showTransliterationSubtitle": "Display Roman transliteration",
  "@showTransliterationSubtitle": { "description": "Explains the transliteration toggle. 'Roman' means the Latin alphabet, not the city." },

  "showTranslation": "Show Translation",
  "@showTranslation": { "description": "Toggle for the translated meaning shown under each verse." },

  "showTranslationSubtitle": "Display translation below Arabic",
  "@showTranslationSubtitle": { "description": "Explains the translation toggle." },

  "aboutAppName": "Quran Kareem",
  "@aboutAppName": { "description": "The app's name as shown in the About section. A proper name — leave untranslated." },

  "textSettings": "Text Settings",
  "@textSettings": { "description": "Row opening the text and reading display settings screen." },

  "textSettingsSubtitle": "Reading mode, font size, swipe navigation",
  "@textSettingsSubtitle": { "description": "Lists what the Text Settings screen contains." },

  "prayerNotifications": "Prayer Notifications",
  "@prayerNotifications": { "description": "Row opening the prayer-time alert settings." },

  "prayerNotificationsSubtitle": "Adhan, vibration, or silent alerts",
  "@prayerNotificationsSubtitle": { "description": "Lists the prayer alert styles available. 'Adhan' is the Islamic call to prayer — keep the term, transliterated as that language conventionally writes it." },

  "dailyRemindersTitle": "Daily Reminders",
  "@dailyRemindersTitle": { "description": "Row opening the daily Quran reading reminder settings." },

  "dailyRemindersSubtitle": "Quran reading & Ayah of the Day",
  "@dailyRemindersSubtitle": { "description": "Lists what the Daily Reminders screen covers. 'Ayah' means a verse of the Quran — keep the term." },

  "readingLanguage": "Reading language",
  "@readingLanguage": { "description": "Which language the Islamic book collections are read in." },

  "noBooksDownloaded": "No books downloaded",
  "@noBooksDownloaded": { "description": "Shown on the books row when nothing has been downloaded yet." },

  "manageDownloads": "Manage downloads",
  "@manageDownloads": { "description": "Link to the screen for removing downloaded books." },

  "manageDownloadsTitle": "Manage Downloads",
  "@manageDownloadsTitle": { "description": "Title of the screen listing downloaded books so they can be deleted." },

  "noBooksDownloadedYet": "No books downloaded yet.",
  "@noBooksDownloadedYet": { "description": "Empty state on the Manage Downloads screen. A full sentence, unlike noBooksDownloaded which is a row subtitle." },

  "delete": "Delete",
  "@delete": { "description": "Button that removes a downloaded book." },

  "translationSource": "Translation Source",
  "@translationSource": { "description": "Which scholar's translation to use for the currently selected language." },

  "rateApp": "Rate Get Quran",
  "@rateApp": { "description": "Row inviting the user to leave a store review. 'Get Quran' is the app's name — leave it untranslated." },

  "rateAppSubtitle": "Share your feedback on the Play Store",
  "@rateAppSubtitle": { "description": "Explains the rate row. 'Play Store' is a product name — leave untranslated." },

  "audioLanguage": "Audio Language",
  "@audioLanguage": { "description": "Which language the recitation audio is in." },

  "audioLanguageSubtitle": "Language for Quran recitation",
  "@audioLanguageSubtitle": { "description": "Explains the Audio Language row." },

  "reciter": "Reciter",
  "@reciter": { "description": "The person reciting the Quran in the audio. A noun for the reader, not the recitation itself." },

  "languageArabic": "Arabic",
  "@languageArabic": { "description": "Language name, shown in a picker. Translate into the display language, e.g. 'Arabe' in French." },

  "languageEnglish": "English",
  "@languageEnglish": { "description": "Language name, shown in a picker. Translate into the display language." },

  "languageUrdu": "Urdu",
  "@languageUrdu": { "description": "Language name, shown in a picker. Translate into the display language." },

  "languageFrench": "French",
  "@languageFrench": { "description": "Language name, shown in a picker. Translate into the display language." },

  "languagePersian": "Persian",
  "@languagePersian": { "description": "Language name, shown in a picker. Translate into the display language. Also known as Farsi." },

  "meaningInLanguage": "Meaning in {language}",
  "@meaningInLanguage": {
    "description": "Subtitle on the reader's translation row, e.g. 'Meaning in French'. {language} arrives already in its own language and is not translated here.",
    "placeholders": {
      "language": {
        "type": "String",
        "example": "French"
      }
    }
  },

  "fontSizePx": "{size}px",
  "@fontSizePx": {
    "description": "A font size in pixels, shown under the font-size sliders. Translators: 'px' is a unit abbreviation — leave it as-is unless the language genuinely uses something else.",
    "placeholders": {
      "size": {
        "type": "int",
        "example": "24"
      }
    }
  },

  "atTime": "at {time}",
  "@atTime": {
    "description": "Secondary line under the sunrise countdown giving the clock time it will happen, e.g. 'at 6:42 AM'.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "6:42 AM"
      }
    }
  }
}
