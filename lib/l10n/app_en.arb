  "textSettingsSectionLivePreview": "LIVE PREVIEW",
  "@textSettingsSectionLivePreview": {
    "description": "Small all-capitals heading in the Text Settings bottom sheet, above a sample verse that updates as the user changes the reading options. Displayed in capitals with wide letter spacing in a 10px font, so keep it very short; use capital letters if that is natural for your language."
  },
  "textSettingsSectionSwipeNavigation": "SWIPE NAVIGATION",
  "@textSettingsSectionSwipeNavigation": {
    "description": "Small all-capitals heading in the Text Settings bottom sheet, above two switches that control moving between Quran chapters by swiping sideways. Displayed in capitals with wide letter spacing in a 10px font, so keep it very short."
  },
  "textSettingsSwipeBetweenSurahs": "Swipe between surahs",
  "@textSettingsSwipeBetweenSurahs": {
    "description": "Label of the switch in the Text Settings sheet that enables moving to the previous or next chapter of the Quran by swiping sideways on the reading page. 'Surah' is the Arabic word for a chapter of the Quran and is normally kept as-is."
  },
  "textSettingsSwipeBetweenSurahsSubtitle": "Swipe left or right to navigate",
  "@textSettingsSwipeBetweenSurahsSubtitle": {
    "description": "One-line explanation under the 'Swipe between surahs' switch in the Text Settings sheet, describing the gesture. Small 11px text on one line."
  },
  "textSettingsShowSurahNameStrip": "Show surah name strip",
  "@textSettingsShowSurahNameStrip": {
    "description": "Label of the switch in the Text Settings sheet that shows a thin horizontal bar of chapter names under the reader's toolbar, for jumping between chapters. 'Surah' is the Arabic word for a chapter of the Quran and is normally kept as-is; 'strip' means a narrow band across the screen."
  },
  "textSettingsShowSurahNameStripSubtitle": "Display navigation bar below reader toolbar",
  "@textSettingsShowSurahNameStripSubtitle": {
    "description": "One-line explanation under the 'Show surah name strip' switch in the Text Settings sheet, saying where that bar appears. 'Reader' is the screen on which the Quran is read. Small 11px text."
  },
  "textSettingsSectionFontSize": "FONT SIZE",
  "@textSettingsSectionFontSize": {
    "description": "Small all-capitals heading in the Text Settings bottom sheet, above a slider and two buttons that scale the translation text. Displayed in capitals with wide letter spacing in a 10px font, so keep it very short."
  },
  "textSettingsSectionTranslationLanguage": "TRANSLATION LANGUAGE",
  "@textSettingsSectionTranslationLanguage": {
    "description": "Small all-capitals heading in the Text Settings bottom sheet, above the row that opens the picker for which Quran translation to read. Displayed in capitals with wide letter spacing in a 10px font. This is the all-capitals heading form of the same idea as the 'Translation Language' settings row."
  },
  "textSettingsPreviewTransliteration": "Alhamdu lillaahi Rabbil 'aalameen",
  "@textSettingsPreviewTransliteration": {
    "description": "Sample phonetic line in the live preview card of the Text Settings sheet, shown in italics under the sample Arabic so the user can judge the text size. It spells the sounds of the Arabic verse 'al-hamdu li-llahi rabbi l-'alamin' (Quran 1:2) in Latin letters. Respell it the way your language conventionally transliterates Arabic; do not translate its meaning (the translation is the separate preview line below it)."
  },
  "textSettingsPreviewTranslation": "All praise is due to Allah, Lord of all the worlds",
  "@textSettingsPreviewTranslation": {
    "description": "Sample translated verse in the live preview card of the Text Settings sheet, shown so the user can judge the translation text size as they change it. It is the meaning of Quran 1:2 (Surah al-Fatihah). 'Allah' is the Arabic name of God: transliterate it conventionally rather than translating it. Use the wording your language's established Quran translations use. No full stop in the English."
  },
  "textSettingsFontSizeDecrease": "A−",
  "@textSettingsFontSizeDecrease": {
    "description": "Label on the small square button to the left of the font-size slider in the Text Settings sheet; tapping it makes the translation text one step smaller. The letter 'A' stands for the alphabet and the character after it is a minus sign (U+2212, not a hyphen). Keep it to two characters; if your script has a conventional letter for 'text size', use that letter in place of 'A' and keep the minus sign."
  },
  "textSettingsFontSizeIncrease": "A+",
  "@textSettingsFontSizeIncrease": {
    "description": "Label on the small square button to the right of the font-size slider in the Text Settings sheet; tapping it makes the translation text one step larger. The letter 'A' stands for the alphabet and '+' is a plus sign. Keep it to two characters; if your script has a conventional letter for 'text size', use that letter in place of 'A' and keep the plus sign."
  },
  "reviewStreakTitle": "{count, plural, =1{{count}-Day Streak! ✨} other{{count}-Day Streak! ✨}}",
  "@reviewStreakTitle": {
    "description": "Congratulatory heading at the top of the dialog that asks the user to rate the app, shown after they have opened it on several consecutive days, e.g. '7-Day Streak! ✨'. A 'streak' is an unbroken run of days. Plural because many languages inflect 'day' by number — add or remove plural categories as your language needs. Keep the sparkle emoji (✨) at the end and the exclamation mark if your language uses one.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "reviewEnjoyingTitle": "Are you enjoying Get Quran?",
  "@reviewEnjoyingTitle": {
    "description": "Question in the middle of the rate-the-app dialog; the user answers with one of the two buttons below it. 'Get Quran' is this app's name — leave it untranslated."
  },
  "reviewEnjoyingBody": "Your feedback helps Muslims around the world discover this app.",
  "@reviewEnjoyingBody": {
    "description": "Two-line sentence under the question in the rate-the-app dialog, giving the user a reason to answer. 'Feedback' here means their opinion or store review."
  },
  "reviewLoveIt": "⭐  Yes, I love it!",
  "@reviewLoveIt": {
    "description": "Label on the main (gold) button in the rate-the-app dialog; tapping it opens the app store review page. The user is answering 'Are you enjoying Get Quran?'. Keep the leading star emoji (⭐) and the two spaces after it, which separate it from the words. One line on a full-width button."
  },
  "reviewNotReally": "💬  Not really…",
  "@reviewNotReally": {
    "description": "Label on the secondary (outlined) button in the rate-the-app dialog; tapping it opens a private feedback form instead of the store. The user is answering 'Are you enjoying Get Quran?' in the negative, politely. Keep the leading speech-balloon emoji (💬), the two spaces after it, and the trailing ellipsis character (…)."
  },
  "reviewRemindLater": "Remind me later",
  "@reviewRemindLater": {
    "description": "Small text link at the bottom of the rate-the-app dialog that closes it and makes the app ask again after a while. Three short words."
  },
  "reviewFeedbackTitle": "We're listening 💌",
  "@reviewFeedbackTitle": {
    "description": "Heading of the second step of the rate-the-app dialog, the private feedback form shown to users who said they are not enjoying the app. It reassures them that their complaint will be read. Keep the love-letter emoji (💌) at the end."
  },
  "reviewFeedbackPrompt": "What could be better? (optional)",
  "@reviewFeedbackPrompt": {
    "description": "Question under the heading of the private feedback form in the rate-the-app dialog, above the text box. '(optional)' tells the user they may send the form empty — keep the parentheses."
  },
  "reviewFeedbackHint": "Type your feedback here…",
  "@reviewFeedbackHint": {
    "description": "Placeholder text inside the empty multi-line text box of the private feedback form in the rate-the-app dialog. Keep the trailing ellipsis character (…)."
  },
  "reviewSendFailed": "Could not send — check your connection.",
  "@reviewSendFailed": {
    "description": "Error line in red under the text box of the private feedback form in the rate-the-app dialog, shown when the feedback could not be uploaded, which is almost always a network problem. Keep the em dash (—) or replace it with the equivalent separator used in your language."
  },
  "reviewSending": "Sending…",
  "@reviewSending": {
    "description": "Label the 'Send Feedback' button of the private feedback form changes to while the feedback is being uploaded; the button is disabled meanwhile. Keep the trailing ellipsis character (…)."
  },
  "reviewSendFeedback": "Send Feedback",
  "@reviewSendFeedback": {
    "description": "Label on the main (gold) button of the private feedback form in the rate-the-app dialog; tapping it uploads what the user typed. One line on a full-width button."
  },
  "reviewNoThanks": "No thanks",
  "@reviewNoThanks": {
    "description": "Small text link at the bottom of the private feedback form in the rate-the-app dialog that closes it without sending anything. A polite refusal; two short words."
  },
  "reviewThanksTitle": "JazakAllah Khair 🤍",
  "@reviewThanksTitle": {
    "description": "Heading of the brief thank-you step shown after feedback has been sent; the dialog closes itself two seconds later. 'JazakAllah Khair' is an Arabic expression of thanks ('may Allah reward you with good'): transliterate it conventionally for your language rather than translating its meaning. Keep the white heart emoji (🤍)."
  },
  "reviewThanksBody": "Your feedback helps us improve the app for the entire community.",
  "@reviewThanksBody": {
    "description": "Two-line sentence under the thank-you heading in the rate-the-app dialog, after the user's feedback has been sent. 'Community' means the app's Muslim users as a whole."
  },
  "langSelectPopularBadge": "POPULAR",
  "@langSelectPopularBadge": {
    "description": "Tiny all-capitals badge on the single language card pinned above the rest of the list on the first-launch language chooser, marking it as the most-used choice. Only a few characters fit in the badge (8px font); use capital letters if that is natural for your language."
  },
  "langSelectTitle": "Choose your language",
  "@langSelectTitle": {
    "description": "Large heading at the top of the first-launch screen where the user picks which language the Quran translation should be in. An instruction to the user."
  },
  "langSelectSubtitle": "Select the language for Quran translations",
  "@langSelectSubtitle": {
    "description": "One-line explanation under the heading of the first-launch language chooser, making clear that the choice applies to the translated meaning of the Quran rather than to the app's own interface."
  },
  "langSelectAllLanguages": "ALL LANGUAGES",
  "@langSelectAllLanguages": {
    "description": "Tiny all-capitals label centred in a horizontal divider on the first-launch language chooser, separating the one pinned popular language above from the full list below. Displayed in capitals with wide letter spacing in a 9px font, so keep it very short."
  },
  "langSelectBismillahTransliteration": "Bismillaahir Rahmaanir Raheem",
  "@langSelectBismillahTransliteration": {
    "description": "Phonetic line shown in italics on every language card of the first-launch language chooser, between the Arabic script above and that language's translation below. It spells the sounds of 'bismillahi r-rahmani r-rahim' ('In the name of Allah, the Most Gracious, the Most Merciful') in Latin letters. Respell it the way your language conventionally transliterates Arabic; do not translate its meaning, which the line below already gives."
  },
  "asmaSubtitle": "The 99 Names of Allah",
  "@asmaSubtitle": {
    "description": "Small line under the Arabic title at the top of the screen listing the ninety-nine names of God, saying in the user's language what the screen contains. 'Allah' is the Arabic name of God: transliterate it conventionally rather than translating it. 11px text on one line."
  },
  "asmaSearchHint": "Search by name or meaning...",
  "@asmaSearchHint": {
    "description": "Placeholder text inside the search box at the top of the 99 Names of Allah screen. 'Name' means one of the ninety-nine names in its Latin-letter spelling and 'meaning' its English sense, either of which the user may type. Keep the three trailing full stops."
  },
  "asmaNoResults": "No names found",
  "@asmaNoResults": {
    "description": "Headline of the empty state on the 99 Names of Allah screen when the user's search text matches none of the names."
  },
  "asmaNoResultsHint": "Try searching by transliteration or meaning",
  "@asmaNoResultsHint": {
    "description": "Advice under the 'No names found' headline on the 99 Names of Allah screen, naming the two things the search box matches on: the name written in Latin letters, and its meaning."
  },
  "asmaGlorifiedTranslation": "Glorified and Exalted be He",
  "@asmaGlorifiedTranslation": {
    "description": "Small caption at the very bottom of the detail sheet for one of the 99 Names of Allah, giving the meaning of the Arabic phrase 'Subhanahu wa Ta'ala' printed directly above it — a formula of praise said after mentioning God. 'He' refers to God. 11px dim text on one line."
  },
  "duasSearchHint": "Search duas in any language…",
  "@duasSearchHint": {
    "description": "Placeholder text inside the search box at the top of the Duas screen. It tells the user they can type in any of the supported languages (Arabic, English, transliteration or Roman Urdu) to find a supplication. Keep it short enough to fit one line in a narrow phone-width text field."
  },
  "duasNoResults": "No duas found",
  "@duasNoResults": {
    "description": "Empty-state message shown centred in the Duas screen when the user's search text matches none of the supplications. 'Duas' are Islamic supplications/prayers."
  },
  "duasCount": "{count, plural, =1{{count} Dua} other{{count} Duas}}",
  "@duasCount": {
    "description": "Small badge showing how many supplications are in a group. Used in two places on the Duas screen: on each category card (e.g. '24 Duas') and under each collapsible prophet heading inside a category. 'Dua' is an Islamic supplication; keep the word untranslated if it is the usual loanword in the target language.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "24"
      }
    }
  },
  "duasRomanUrduLabel": "Roman Urdu",
  "@duasRomanUrduLabel": {
    "description": "Tiny all-caps section heading above the Roman Urdu rendering of a supplication, inside an expanded dua card. 'Roman Urdu' means the Urdu language written in Latin letters rather than the Urdu script. The app uppercases this string itself, so provide it in normal title case."
  },
  "duasCopy": "Copy",
  "@duasCopy": {
    "description": "Label of the small button at the bottom of an expanded dua card that copies the supplication's text to the device clipboard. Shown next to a copy icon, so it must stay very short (one word)."
  },
  "duasCopiedToClipboard": "Dua copied to clipboard",
  "@duasCopiedToClipboard": {
    "description": "Brief confirmation toast (snackbar) shown after the user taps the Copy button on a dua card and the supplication's text has been placed on the device clipboard."
  },
  "duasCopySourceLine": "Source: {source}",
  "@duasCopySourceLine": {
    "description": "Last line of the plain text that is copied to the clipboard when the user copies a dua. It credits the scripture or hadith collection the supplication is taken from. Translate only the word 'Source:'; the reference itself is inserted as-is and is not translated.",
    "placeholders": {
      "source": {
        "type": "String",
        "example": "Sahih Bukhari 6307"
      }
    }
  },
  "hasanatCalculatorTitle": "Hasanat Calculator",
  "@hasanatCalculatorTitle": {
    "description": "Title in the top bar of the rewards calculator screen, which works out how many rewards a charitable donation may earn. 'Hasanat' is the Arabic word for good deeds or rewards recorded for a believer: transliterate it conventionally rather than translating its meaning. Two words at 16px on one centred line."
  },
  "hasanatCalculatorSubtitle": "Rewards promised in the Quran & Hadeeth",
  "@hasanatCalculatorSubtitle": {
    "description": "Small italic second line under the 'Hasanat Calculator' title in the top bar, saying that the figures on this screen come from Islamic scripture rather than from the app's own arithmetic. 'Hadeeth' means the recorded sayings of the Prophet Muhammad: transliterate it conventionally rather than translating it. Very small text (10px) on one line — stay brief."
  },
  "hasanatTabOneTime": "One Time",
  "@hasanatTabOneTime": {
    "description": "Name of the first of two tabs on the rewards calculator screen. This tab calculates the reward for a single, one-off donation. Sits in a narrow tab, so keep it to one or two short words."
  },
  "hasanatTabRecurring": "Recurring",
  "@hasanatTabRecurring": {
    "description": "Name of the second of two tabs on the rewards calculator screen. This tab calculates the reward for a donation repeated every month over a chosen number of years. Sits in a narrow tab, so keep it to one or two short words."
  },
  "hasanatSectionAmount": "Amount",
  "@hasanatSectionAmount": {
    "description": "Tiny all-caps heading above the box where the user types the sum of money they intend to give, on the one-off donation tab of the rewards calculator. The app uppercases it; keep it to one short word."
  },
  "hasanatSectionMonthlyAmount": "Monthly Amount",
  "@hasanatSectionMonthlyAmount": {
