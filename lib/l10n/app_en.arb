  "hifzLoopTooltipMark": "Tap ★ to mark this verse memorized",
  "@hifzLoopTooltipMark": {
    "description": "First step of the guided tour of the memorisation looper: a small gold speech bubble pointing down at the star button in the player controls. ★ stands for that button; keep the character. Two or three short lines of white text at most."
  },
  "hifzLoopTapToContinue": "Tap anywhere to continue",
  "@hifzLoopTapToContinue": {
    "description": "Faint second line inside the first speech bubble of the guided tour of the memorisation looper, telling the user that a tap anywhere on the screen moves on to the next tip. Very small text."
  },
  "hifzLoopTooltipRepeats": "Tap ⚙ to adjust repeats per verse",
  "@hifzLoopTooltipRepeats": {
    "description": "Second step of the guided tour of the memorisation looper: a small gold speech bubble pointing up at the sliders icon in the top right of the title bar, which opens the settings panel. ⚙ stands for that icon; keep the character. Two or three short lines of white text at most."
  },
  "hifzLoopTapToDismiss": "Tap anywhere to dismiss",
  "@hifzLoopTapToDismiss": {
    "description": "Faint second line inside the last speech bubble of the guided tour of the memorisation looper, telling the user that a tap anywhere closes the tour for good. Very small text."
  },
  "hifzLoopMashaAllah": "Masha Allah!",
  "@hifzLoopMashaAllah": {
    "description": "Congratulatory headline on the card that appears once the user has marked every verse of a chapter as memorised, shown directly under the same phrase written in Arabic script. A transliterated Arabic expression of praise and delight at someone's achievement: respell it as your language conventionally does rather than translating its meaning."
  },
  "hifzLoopYouHaveMemorized": "You have memorized",
  "@hifzLoopYouHaveMemorized": {
    "description": "Small lead-in line on the congratulation card shown when a whole chapter has been memorised; the chapter's name follows it on the next line, in Latin letters and then in Arabic script. Word it so that a name reads naturally after it."
  },
  "hifzLoopQuranQuote": "\"And We have certainly made the Quran easy to remember.\"\n— Quran 54:17",
  "@hifzLoopQuranQuote": {
    "description": "Quran quotation in a small panel on the congratulation card shown when a whole chapter has been memorised. Keep the line break (\\n) between the quotation and its citation, keep the quotation inside quotation marks, and keep '54:17' (chapter 54, verse 17) with its numerals and colon as they are. Use your language's established wording of this verse if there is one, and keep the em dash before the citation or replace it with your language's equivalent separator."
  },
  "hifzLoopVersesMemorizedOfTotal": "{count} of {total, plural, =1{{total} verse} other{{total} verses}} memorized",
  "@hifzLoopVersesMemorizedOfTotal": {
    "description": "Small summary line near the bottom of the congratulation card shown when a whole chapter has been memorised, e.g. '7 of 7 verses memorized'. In practice the two numbers are always equal here. The plural applies to the total.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "7"
      },
      "total": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "hifzLoopAlhamdulillah": "Alhamdulillah  ✓",
  "@hifzLoopAlhamdulillah": {
    "description": "Label on the gold pill button that closes the congratulation card shown when a whole chapter has been memorised. A transliterated Arabic expression of thanks to God ('praise be to God'): respell it as your language conventionally does rather than translating its meaning. Keep the trailing check mark (✓) and the two spaces before it."
  },
  "hifzLoopRepeatsPerVerse": "Repeats per verse",
  "@hifzLoopRepeatsPerVerse": {
    "description": "Label of the first row of the settings panel of the memorisation looper, with minus and plus buttons at the right that set how many times each verse is replayed before the player moves on. Space is tight: the row also holds the two buttons and the number."
  },
  "hifzLoopRepeatsValue": "{count}×",
  "@hifzLoopRepeatsValue": {
    "description": "The chosen number of repeats, shown between the minus and plus buttons in the settings panel of the memorisation looper, e.g. '3×' meaning each verse plays three times. The '×' means 'times'; replace it only if your language has a different established multiplier mark. The slot is about three characters wide.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "hifzLoopAutoAdvance": "Auto-advance",
  "@hifzLoopAutoAdvance": {
    "description": "Label of the row in the settings panel of the memorisation looper whose on/off switch decides whether the player moves on to the next verse by itself once the chosen number of repeats is done. Keep it to one or two short words."
  },
  "hifzLoopSpeed": "Speed",
  "@hifzLoopSpeed": {
    "description": "Label of the row in the settings panel of the memorisation looper followed by five small buttons choosing how fast the recitation is played. One short word — the buttons share the row."
  },
  "hifzLoopSpeedValue": "{speed}×",
  "@hifzLoopSpeedValue": {
    "description": "One of five small playback-speed buttons in the settings panel of the memorisation looper, e.g. '1.0×' meaning normal speed and '1.5×' meaning one and a half times as fast. The '×' means 'times'; replace it only if your language has a different established multiplier mark. The button is only a few characters wide.",
    "placeholders": {
      "speed": {
        "type": "String",
        "example": "1.5"
      }
    }
  },
  "hifzLoopMemorized": "Memorized",
  "@hifzLoopMemorized": {
    "description": "Gold label next to a star icon under the verse in the memorisation looper, shown only once the user has marked the verse on screen as memorised. A state, not a button. One short word."
  },
  "hifzLoopMemorizedShort": "Mem.",
  "@hifzLoopMemorizedShort": {
    "description": "Tiny caption under the star button in the player controls of the memorisation looper while the verse on screen is already marked as memorised; tapping unmarks it. A deliberate abbreviation of 'memorized' — only about five characters fit in a 9px font, so abbreviate in the target language too."
  },
  "hifzLoopMarkShort": "Mark",
  "@hifzLoopMarkShort": {
    "description": "Tiny caption under the star button in the player controls of the memorisation looper while the verse on screen is not yet marked as memorised; tapping marks it. A verb in the imperative. Only about five characters fit in a 9px font."
  },
  "hifzLoopProgressInSurah": "{count} of {total} verses memorized in {surahName}",
  "@hifzLoopProgressInSurah": {
    "description": "Caption under the thin progress bar at the very bottom of the memorisation looper, e.g. '3 of 7 verses memorized in Al-Fatihah'. {surahName} is the chapter's transliterated Arabic name and is never translated. One line in a 10px font, so stay terse.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      },
      "total": {
        "type": "int",
        "example": "7"
      },
      "surahName": {
        "type": "String",
        "example": "Al-Fatihah"
      }
    }
  },
  "modePickerPreviewSurahName": "Al-Fatihah",
  "@modePickerPreviewSurahName": {
    "description": "Title bar of the one-time screen where the user chooses how much of each verse to show while reading. It names the chapter of the Quran used for the sample verses on that screen, the first one. A transliterated Arabic name: respell it as your language conventionally does rather than translating its meaning."
  },
  "modePickerSubtitle": "Choose how you want to read",
  "@modePickerSubtitle": {
    "description": "One-line instruction under the title bar of the one-time screen where the user picks a reading layout, above three sample cards. Centred on one or two lines."
  },
  "modePickerScrollHint": "scroll to compare",
  "@modePickerScrollHint": {
    "description": "Caption under a gently bouncing downward arrow floating above the footer of the reading-layout picker, telling the user that the other sample cards are further down the page. Shown in lower case with wide letter spacing in a very small font, and it disappears as soon as the user scrolls — keep it to two or three short words."
  },
  "modePickerChangeLaterHint": "You can always change this in Settings › Text Settings",
  "@modePickerChangeLaterHint": {
    "description": "Reassuring line in the pinned footer of the reading-layout picker, saying the choice is not final. 'Settings' and 'Text Settings' are the names of two screens in this app and should match how those are worded in your translation; '›' separates the two steps of that path and should be kept."
  },
  "modePickerStartReading": "Start Reading — {mode}",
  "@modePickerStartReading": {
    "description": "Label on the wide gold button at the bottom of the reading-layout picker, which saves the choice and closes the screen, e.g. 'Start Reading — Arabic + Translation'. {mode} is the name of the layout the user has selected, already translated. Keep the em dash or replace it with your language's equivalent separator; the whole label must fit one line on a button.",
    "placeholders": {
      "mode": {
        "type": "String",
        "example": "Arabic + Translation"
      }
    }
  },
  "modePickerModeTranslationOnly": "Translation only",
  "@modePickerModeTranslationOnly": {
    "description": "Name of the first of three reading layouts, which shows only the translated meaning of each verse and no Arabic. Appears as the title of its sample card on the reading-layout picker and inside the label of the confirm button, so keep it short."
  },
  "modePickerModeTranslationOnlyDesc": "Just the meaning — clean and focused",
  "@modePickerModeTranslationOnlyDesc": {
    "description": "One-line description under the 'Translation only' card title on the reading-layout picker, praising the layout as uncluttered. Keep the em dash or replace it with your language's equivalent separator."
  },
  "modePickerModeArabicTranslation": "Arabic + Translation",
  "@modePickerModeArabicTranslation": {
    "description": "Name of the second of three reading layouts, which shows the Arabic scripture with its translated meaning under each verse. Appears as the title of its sample card on the reading-layout picker and inside the label of the confirm button, so keep it short; the '+' means 'together with' and can be kept as-is."
  },
  "modePickerModeArabicTranslationDesc": "Arabic text with meaning below each verse",
  "@modePickerModeArabicTranslationDesc": {
    "description": "One-line description under the 'Arabic + Translation' card title on the reading-layout picker, saying where the translated meaning appears relative to the scripture."
  },
  "modePickerModeArabicTransliteration": "Arabic + Transliteration",
  "@modePickerModeArabicTransliteration": {
    "description": "Name of the third of three reading layouts, which shows the Arabic scripture, then its sounds spelled out in Latin letters, then the translated meaning. Appears as the title of its sample card on the reading-layout picker and inside the label of the confirm button, so keep it short; the '+' means 'together with' and can be kept as-is."
  },
  "modePickerModeArabicTransliterationDesc": "Arabic, Roman phonetics, and translation",
  "@modePickerModeArabicTransliterationDesc": {
    "description": "One-line description under the 'Arabic + Transliteration' card title on the reading-layout picker, listing the three things each verse shows in that layout. 'Roman phonetics' means the sounds of the Arabic written in the Latin alphabet — not the city or the Romanian language."
  },
  "modePickerPreviewTranslit1": "Bismillaahir Rahmaanir Raheem",
  "@modePickerPreviewTranslit1": {
    "description": "Sample line on the reading-layout picker: the sounds of the first verse of the Quran's opening chapter spelled out in Latin letters, shown so the user can see what the transliteration layout looks like. It is a phonetic respelling of Arabic, not a sentence to translate — if your language reads another script, respell the same Arabic sounds the way that script conventionally does; otherwise leave it as it is. The Arabic original above it is fixed and never changes."
  },
  "modePickerPreviewTranslit2": "Alhamdu lillaahi Rabbil 'aalameen",
  "@modePickerPreviewTranslit2": {
    "description": "Sample line on the reading-layout picker: the sounds of the second verse of the Quran's opening chapter spelled out in Latin letters, shown so the user can see what the transliteration layout looks like. It is a phonetic respelling of Arabic, not a sentence to translate — if your language reads another script, respell the same Arabic sounds the way that script conventionally does; otherwise leave it as it is."
  },
  "modePickerPreviewTranslit3": "Ar-Rahmaanir Raheem",
  "@modePickerPreviewTranslit3": {
    "description": "Sample line on the reading-layout picker: the sounds of the third verse of the Quran's opening chapter spelled out in Latin letters, shown so the user can see what the transliteration layout looks like. It is a phonetic respelling of Arabic, not a sentence to translate — if your language reads another script, respell the same Arabic sounds the way that script conventionally does; otherwise leave it as it is."
  },
  "modePickerPreviewTranslation1": "In the name of Allah, the Entirely Merciful, the Especially Merciful",
  "@modePickerPreviewTranslation1": {
    "description": "Sample line on the reading-layout picker: the meaning of the first verse of the Quran's opening chapter, shown so the user can see what each layout looks like in their own language. Use your language's established translation of this verse rather than translating the English wording word for word. 'Allah' is the Arabic name of God: transliterate it conventionally if that is what your language's Quran translations do."
  },
  "modePickerPreviewTranslation2": "All praise is due to Allah, Lord of all the worlds",
  "@modePickerPreviewTranslation2": {
    "description": "Sample line on the reading-layout picker: the meaning of the second verse of the Quran's opening chapter, shown so the user can see what each layout looks like in their own language. Use your language's established translation of this verse rather than translating the English wording word for word."
  },
  "modePickerPreviewTranslation3": "The Entirely Merciful, the Especially Merciful",
  "@modePickerPreviewTranslation3": {
    "description": "Sample line on the reading-layout picker: the meaning of the third verse of the Quran's opening chapter, shown so the user can see what each layout looks like in their own language. Use your language's established translation of this verse rather than translating the English wording word for word."
  },
  "widgetNextPrayer": "Next Prayer",
  "@widgetNextPrayer": {
    "description": "Heading on the home-screen widget above the upcoming prayer. Rendered by the native widget, not the app, so it must fit a small tile — keep it short."
  },
  "widgetNext": "Next",
  "@widgetNext": {
    "description": "Very short form of \"Next Prayer\" for the compact widget, where the full heading does not fit. Agrees with the word for prayer in gendered languages."
  },
  "widgetOpenApp": "Open app",
  "@widgetOpenApp": {
    "description": "Shown on the Qibla home-screen widget when it has no bearing yet, inviting the user to open the app so it can get a location. Rendered by the native widget on a small tile — keep it very short."
