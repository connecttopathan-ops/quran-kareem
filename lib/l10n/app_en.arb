    "placeholders": {
      "appName": {
        "type": "String",
        "example": "Get Quran"
      }
    }
  },
  "permBatteryTipHuawei": "Huawei extra step: Settings → Battery → App launch → {appName} → Manage manually → enable all toggles",
  "@permBatteryTipHuawei": {
    "description": "Extra instruction shown in a small bordered note inside the 'Always Run in Background' row on the notification permissions sheet, displayed only on Huawei and Honor phones. The words after 'Huawei extra step:' are the literal names of menu items in Huawei's own Android settings, which the phone shows in the user's language: if you know Huawei's official wording for these menus in your locale, use exactly that; otherwise leave the English menu names untranslated, because a guessed translation leaves the user unable to find the menu. Translate only the surrounding words ('extra step', 'enable all toggles'). Keep the → arrows as separators. {appName} is this app's name and is never translated.",
    "placeholders": {
      "appName": {
        "type": "String",
        "example": "Get Quran"
      }
    }
  },
  "permBatteryTipOppo": "Extra step: Settings → Battery → Battery optimization → {appName} → Don't optimize",
  "@permBatteryTipOppo": {
    "description": "Extra instruction shown in a small bordered note inside the 'Always Run in Background' row on the notification permissions sheet, displayed only on Oppo, Realme and OnePlus phones. Unlike the other manufacturer tips this one names no manufacturer, because it covers three brands — do not add one. The words after 'Extra step:' are the literal names of menu items in the phone's own Android settings, which it shows in the user's language: if you know that manufacturer's official wording for these menus in your locale, use exactly that; otherwise leave the English menu names (including \"Don't optimize\") untranslated, because a guessed translation leaves the user unable to find the menu. Translate only 'Extra step'. Keep the → arrows as separators. {appName} is this app's name and is never translated.",
    "placeholders": {
      "appName": {
        "type": "String",
        "example": "Get Quran"
      }
    }
  },
  "permBatteryTipVivo": "Vivo extra step: Settings → Battery → High background power consumption → add {appName}",
  "@permBatteryTipVivo": {
    "description": "Extra instruction shown in a small bordered note inside the 'Always Run in Background' row on the notification permissions sheet, displayed only on Vivo phones. The words after 'Vivo extra step:' are the literal names of menu items in Vivo's own Android settings, which the phone shows in the user's language: if you know Vivo's official wording for these menus in your locale, use exactly that; otherwise leave the English menu names untranslated, because a guessed translation leaves the user unable to find the menu. Translate only the surrounding words ('extra step', 'add'). Keep the → arrows as separators. {appName} is this app's name and is never translated.",
