  "hifzAyahsOfTotal": "{count} of {total, plural, =1{{total} ayah} other{{total} ayahs}}",
  "@hifzAyahsOfTotal": {
    "description": "Small caption under the whole-Quran progress bar on the Hifz (memorisation) screen, saying how many verses of the Quran the user has memorised out of all 6236, e.g. '42 of 6236 ayahs'. 'Ayah' is the Arabic word for a Quran verse: transliterate it conventionally rather than translating its meaning. The plural applies to the total, which in practice is always 6236.",
    "placeholders": {
      "count": {
