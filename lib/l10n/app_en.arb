  "qiblaAccuracyMedium": "Accuracy: Medium",
  "@qiblaAccuracyMedium": {
    "description": "Status shown beside an orange warning triangle in the top right of the compass screen when the magnetic readings wobble somewhat. Very small text (11px) on one line; 'Accuracy' labels the reading and 'Medium' is its level."
  },
  "qiblaAccuracyLow": "Accuracy: Low",
  "@qiblaAccuracyLow": {
    "description": "Status shown beside a red cross in the top right of the compass screen when the magnetic readings are too noisy to trust, usually because of nearby metal or electronics. Very small text (11px) on one line; 'Accuracy' labels the reading and 'Low' is its level."
  },
  "qiblaCompassNorth": "N",
  "@qiblaCompassNorth": {
    "description": "Single-letter abbreviation for north, drawn at the top of the compass dial on the Qibla screen. Use the initial your language uses on a compass rose; there is room for one or at most two characters."
  },
  "qiblaCompassEast": "E",
  "@qiblaCompassEast": {
    "description": "Single-letter abbreviation for east, drawn at the right of the compass dial on the Qibla screen. Use the initial your language uses on a compass rose; there is room for one or at most two characters."
  },
  "qiblaCompassSouth": "S",
  "@qiblaCompassSouth": {
    "description": "Single-letter abbreviation for south, drawn at the bottom of the compass dial on the Qibla screen. Use the initial your language uses on a compass rose; there is room for one or at most two characters."
  },
  "qiblaCompassWest": "W",
  "@qiblaCompassWest": {
    "description": "Single-letter abbreviation for west, drawn at the left of the compass dial on the Qibla screen. Use the initial your language uses on a compass rose; there is room for one or at most two characters."
  },
  "sponsorScreenTitle": "Support Get Quran",
  "@sponsorScreenTitle": {
    "description": "Title in the top bar of the screen that opens the project's donation page in an embedded web view. 'Get Quran' is the app's own name and must stay untranslated; translate only the word 'Support', which here means 'help fund'. One centred line at 16px next to a heart icon."
  },
  "hifzSearchHint": "Search surah name or number…",
  "@hifzSearchHint": {
    "description": "Placeholder text inside the search box at the top of the Hifz (Quran memorisation) screen. The user types either a chapter's name or its number from 1 to 114 to filter the list below. 'Surah' is the Arabic word for a chapter of the Quran and is normally kept as-is. Keep the trailing ellipsis character."
  },
  "hifzMetricAyahs": "Ayahs",
  "@hifzMetricAyahs": {
    "description": "Caption under a large number on one of three small statistic cards at the top of the Hifz (memorisation) screen; the number is how many individual Quran verses the user has marked as memorised so far. A bare noun with no number attached, so use the plural form. 'Ayah' is the Arabic word for a Quran verse: transliterate it conventionally rather than translating its meaning. The card is narrow — one short word."
  },
  "hifzMetricTodayReps": "Today's Reps",
  "@hifzMetricTodayReps": {
    "description": "Caption under a large number on one of three small statistic cards at the top of the Hifz (memorisation) screen; the number is how many times the user has listened through a verse today while practising. 'Reps' is short for 'repetitions'. The card is narrow (about 12 characters) — abbreviate in the target language too if needed."
  },
  "hifzQuranProgress": "Quran Progress",
  "@hifzQuranProgress": {
    "description": "Heading at the left of a card on the Hifz (memorisation) screen that holds a progress bar for the whole Quran; the matching percentage sits at the right of the same row. Two short words."
  },
  "hifzProgressPercent": "{percent}%",
  "@hifzProgressPercent": {
    "description": "The share of the whole Quran the user has memorised, shown at the right of the 'Quran Progress' row on the Hifz screen, e.g. '12.3%'. The value arrives already formatted with one decimal place. Keep the per-cent sign unless your language places or writes it differently.",
