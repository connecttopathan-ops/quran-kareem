  },
  "hasanatDurationYears": "{count, plural, =1{{count} year} other{{count} years}}",
  "@hasanatDurationYears": {
    "description": "A giving period of a whole number of years on the recurring tab of the rewards calculator. Shown large under the duration slider, as the right end label of that slider (always '30 years' there), and in the summary card. Plural because many languages inflect the noun.",
    "placeholders": {
      "count": {
        "type": "int",
